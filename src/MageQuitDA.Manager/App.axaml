<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MageQuitDA.Manager.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="MqPurple">#2A1F45</SolidColorBrush>
    <SolidColorBrush x:Key="MqPurpleDeep">#1B1430</SolidColorBrush>
    <SolidColorBrush x:Key="MqPurpleLight">#3C2D63</SolidColorBrush>
    <SolidColorBrush x:Key="MqYellow">#E8D45E</SolidColorBrush>
    <SolidColorBrush x:Key="MqWarn">#F2A65A</SolidColorBrush>
    <SolidColorBrush x:Key="MqMuted">#A99CC8</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#8A5CF0" RegionColor="#1B1430" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource MqYellow}" />
      <Setter Property="Foreground" Value="#1B1430" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F5E37A" />
      <Setter Property="Foreground" Value="#1B1430" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MqMuted}" />
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="Foreground" Value="{StaticResource MqMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
