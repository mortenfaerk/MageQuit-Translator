<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:MageQuitDA.Manager"
        mc:Ignorable="d"
        x:Class="MageQuitDA.Manager.MainWindow"
        x:DataType="local:MainViewModel"
        Title="{Binding Title}"
        Width="1180" Height="780" MinWidth="880" MinHeight="560"
        Background="{StaticResource MqPurpleDeep}"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header: game folder and install actions -->
    <Border Grid.Row="0" Background="{StaticResource MqPurple}" Padding="20,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="MageQuit på dansk" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding AppVersion}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Spilmappe:" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameDir, FallbackValue='(ikke fundet)', TargetNullValue='(ikke fundet)'}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
            <Button Content="Vælg…" Click="OnBrowse" Padding="10,2" />
          </StackPanel>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MqYellow}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="primary" Content="{Binding InstallButtonText}" Click="OnInstall"
                  IsEnabled="{Binding CanInstall}" Padding="16,8" />
          <Button Content="{Binding ToggleButtonText}" Click="OnToggle" IsEnabled="{Binding CanEdit}" Padding="12,8" />
          <Button Content="Afinstallér" Click="OnUninstall" IsEnabled="{Binding CanEdit}" Padding="12,8" />
          <Button Content="Start spillet" Click="OnLaunch" IsEnabled="{Binding HasGame}" Padding="12,8" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Steam Deck / Linux: BepInEx needs a launch option under Proton -->
    <Border Grid.Row="1" IsVisible="{Binding ShowLinuxHint}" Background="#3A2A18" Padding="20,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Linux/Steam Deck: Sæt denne startindstilling på MageQuit i Steam (Egenskaber → Startindstillinger):" />
        <TextBox Text="{Binding LinuxLaunchOption}" IsReadOnly="True" MinWidth="300" />
        <Button Content="Kopiér" Click="OnCopyLaunchOption" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="2" Margin="12,6,12,0" IsEnabled="{Binding CanEdit}">

      <!-- Text translations -->
      <TabItem Header="Tekster">
        <Grid ColumnDefinitions="*,6,360" RowDefinitions="Auto,*">
          <WrapPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBox Text="{Binding Search}" PlaceholderText="Søg…" Width="200" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="200" Margin="0,0,8,0">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:FilterOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="primary" Content="Gem (Ctrl+S)" Click="OnSave" Margin="0,0,8,0" />
            <Button Content="Importér opfangede" Click="OnImportCaptured" Margin="0,0,8,0" />
            <CheckBox Content="Opfang i spillet" IsChecked="{Binding CaptureEnabled}" Margin="0,0,8,0"
                      ToolTip.Tip="Spillet gemmer alle tekster, det viser, så manglende tekster kan importeres her." />
            <Button Content="Eksportér…" Click="OnExport" Margin="0,0,8,0" />
            <Button Content="Importér fil…" Click="OnImportFile" />
          </WrapPanel>

          <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                    AutoGenerateColumns="False" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column" IsReadOnly="False" RowHeight="32">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Engelsk" Binding="{Binding EnDisplay}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Dansk" Binding="{Binding Da}" Width="*" />
              <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" IsReadOnly="True" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

          <GridSplitter Grid.Row="1" Grid.Column="1" Background="Transparent" />

          <!-- Details for the selected string -->
          <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource MqPurple}" CornerRadius="6" Padding="14">
            <ScrollViewer>
              <StackPanel DataContext="{Binding Selected}" x:DataType="local:EntryViewModel" Spacing="2">
                <TextBlock Classes="h" Text="ENGELSK" Margin="0,0,0,4" />
                <SelectableTextBlock Text="{Binding En}" TextWrapping="Wrap" />
                <TextBlock Classes="h" Text="DANSK" />
                <TextBox Text="{Binding Da}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource MqWarn}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Content="✔ Godkend" Click="OnApprove" />
                  <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="muted" />
                </StackPanel>
                <TextBlock Classes="h" Text="NOTE" />
                <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" />
                <TextBlock Classes="h" Text="HVOR TEKSTEN FINDES" />
                <TextBlock Text="{Binding Sources}" TextWrapping="Wrap" FontSize="12" Classes="muted" />
                <TextBlock Classes="h" Text="SKRIFTTYPE · TYPE" />
                <TextBlock FontSize="12" Classes="muted" TextWrapping="Wrap">
                  <Run Text="{Binding Fonts}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Kind}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Confidence}" />
                </TextBlock>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- Menu labels that are images in the game -->
      <TabItem Header="Knapper">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,10"
                     Text="Nogle menupunkter er billeder i spillet. De tegnes på dansk med spillets egen skrifttype. Gem og genstart spillet for at se ændringerne." />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Labels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LabelViewModel">
                  <Border Background="{StaticResource MqPurple}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="180,240,*">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding En}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Size}" Classes="muted" FontSize="11" />
                      </StackPanel>
                      <TextBox Grid.Column="1" Text="{Binding Da}" VerticalAlignment="Center" Margin="0,0,16,0" />
                      <Border Grid.Column="2" Background="{StaticResource MqPurpleLight}" CornerRadius="4" Padding="10"
                              HorizontalAlignment="Left">
                        <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="60" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Log">
        <ListBox ItemsSource="{Binding Log}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:LogLine">
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <Border Grid.Row="3" Padding="20,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Progress}" Classes="muted" />
        <TextBlock Grid.Column="1" Classes="muted" FontSize="12"
                   Text="I spillet: Alt+R genindlæser tekster · Alt+T skifter dansk/engelsk · F11 tager et skærmbillede" />
      </Grid>
    </Border>
  </Grid>
</Window>
