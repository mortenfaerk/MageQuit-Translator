  "components": [
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Default outlined action; every secondary action on a page.",
      "html": "<button class=\"ds-btn-quiet\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M5 3 H16 L21 8 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M7 3 V8 H15 M7 21 V14 H17 V21\"/></svg>Save</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;gap:7px;background:transparent;color:#B9ADD6;border:1px solid #4A3A70;border-radius:3px;padding:7px 12px;font:400 14px Inter,'Segoe UI',sans-serif;cursor:pointer}.ds-btn-quiet svg{fill:none;stroke:#B9ADD6;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-btn-quiet:hover{background:#36265A;color:#EFE7FF;border-color:#A196C6}.ds-btn-quiet:hover svg{stroke:#EFE7FF}.ds-btn-quiet:active{background:#3E2C68}.ds-btn-quiet:focus-visible{outline:none;border-color:#E8C25A}"
    },
    {
      "name": "Gilt Button",
      "kind": "button",
      "refersTo": "button-gilt",
      "description": "The single primary action of a page.",
      "html": "<button class=\"ds-btn-gilt\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M7 4 L19 12 L7 20 Z\"/></svg>Play in Dansk</button>",
      "css": ".ds-btn-gilt{display:inline-flex;align-items:center;gap:10px;background:#E8C25A;color:#1B1230;border:1px solid #B8902F;border-radius:3px;padding:12px 22px;font:600 16px Inter,'Segoe UI',sans-serif;cursor:pointer}.ds-btn-gilt svg{fill:#1B1230;stroke:#1B1230;stroke-width:2;stroke-linejoin:round}.ds-btn-gilt:hover{background:#F2D27A;border-color:#E8C25A}.ds-btn-gilt:active{background:#B8902F}.ds-btn-gilt:focus-visible{outline:2px solid #EFE7FF;outline-offset:2px}"
    },
    {
      "name": "Boxed Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Form and search fields; focus becomes a gilt underline.",
      "html": "<input class=\"ds-field\" placeholder=\"Search all chapters\">",
      "css": ".ds-field{background:#241839;color:#EFE7FF;border:1px solid #4A3A70;border-radius:3px;padding:6px 10px;font:400 14px Inter,'Segoe UI',sans-serif;caret-color:#E8C25A;width:210px}.ds-field::placeholder{color:#A196C6}.ds-field:hover{background:#2A1D43;border-color:#A196C6}.ds-field:focus{outline:none;background:#2A1D43;border-color:transparent;border-bottom:2px solid #E8C25A}"
    },
    {
      "name": "Ink Field",
      "kind": "input",
      "refersTo": "field-ink",
      "description": "Unboxed translation field on the recto page, with its length budget beneath.",
      "html": "<div class=\"ds-ink-wrap\"><input class=\"ds-field-ink\" value=\"(før kastet)\"><div class=\"ds-budget\"></div></div>",
      "css": ".ds-ink-wrap{background:#2B1D48;padding:8px 16px;width:280px}.ds-field-ink{background:transparent;color:#EFE7FF;border:0;border-bottom:1px solid transparent;padding:6px 0;font:400 14.5px Inter,'Segoe UI',sans-serif;caret-color:#E8C25A;width:100%}.ds-field-ink:hover{border-bottom-color:#4A3A70}.ds-field-ink:focus{outline:none;border-bottom-color:#E8C25A}.ds-budget{height:1.5px;width:66px;background:#A196C6;margin-top:2px}"
    },
    {
      "name": "Play / Translate Switch",
      "kind": "nav",
      "refersTo": "button-bare",
      "description": "The two ways into the book, in small caps.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-on\" href=\"#\">Play</a><a href=\"#\">Translate</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;background:#1B1230;padding:8px}.ds-nav a{font:400 17px 'IM FELL English SC',Georgia,serif;font-variant:small-caps;color:#B9ADD6;text-decoration:none;padding:6px 8px;border-bottom:1.5px solid transparent}.ds-nav a:hover{color:#EFE7FF}.ds-nav a:focus-visible{outline:1px solid #E8C25A}.ds-nav a.ds-nav-on{color:#EFE7FF;border-bottom-color:#EFE7FF}"
    },
    {
      "name": "Seal Legend",
      "kind": "custom",
      "refersTo": "",
      "description": "Unsealed ring, draft dash, sealed gilt disc; translation review state only.",
